# Server-only — never expose to the browser bundle.
BACKEND_INTERNAL_URL=http://127.0.0.1:3000

# Public admin-web origin (scheme + host[:port]). Used for CSRF/Origin checks
# on mutating BFF requests and as the trusted Origin forwarded to the backend.
# Required in production. Loopback hosts localhost / 127.0.0.1 / ::1 are treated
# as equivalent for the same scheme and port (browser may use either).
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:3001

# Optional public badge label (development | staging | production).
NEXT_PUBLIC_ADMIN_ENV=development

# Cookie Secure flag for session/CSRF cookies set by the BFF.
# Set true behind HTTPS. Leave unset for local HTTP (cookies follow request protocol).
# COOKIE_SECURE=true
