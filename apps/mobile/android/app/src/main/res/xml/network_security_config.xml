<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is required for local Nest backends over LAN HTTP.
  Tighten / require TLS before any store or production distribution milestone.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
