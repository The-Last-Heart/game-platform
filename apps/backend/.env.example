PORT=3000
NODE_ENV=development
LOG_LEVEL=log

# Local Docker Compose defaults (infra/local). Not for production.
DATABASE_URL=postgres://lh_local:lh_local_dev_only@127.0.0.1:5432/the_last_heart
REDIS_URL=redis://127.0.0.1:6379

# Set to "false" only when intentionally skipping dependency checks (e.g. unit tests).
HEALTH_CHECK_DEPENDENCIES=true

# Admin session absolute lifetime (default 12h).
ADMIN_SESSION_TTL_SECONDS=43200

# Redis login throttle (failures per normalized email).
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_THROTTLE_TTL_SECONDS=900

# CSRF HMAC secret (change in every non-local environment).
ADMIN_CSRF_SECRET=lh-dev-csrf-secret-change-me

# Allowed browser Origin for mutating admin requests (admin-web / BFF origin).
# Required in production. BFF validates the browser Origin and forwards this value.
ADMIN_ALLOWED_ORIGIN=http://127.0.0.1:3001

# Set true behind HTTPS / production.
COOKIE_SECURE=false

# Optional first super_admin bootstrap (never commit real secrets).
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-12
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Bootstrap Admin
