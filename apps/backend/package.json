{
  "name": "@thelastheart/backend",
  "version": "0.0.1",
  "description": "The Last Heart authoritative backend (foundation)",
  "author": "The Last Heart",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "db:migrate:status": "ts-node -r tsconfig-paths/register src/database/migrate-status.ts",
    "admin:bootstrap": "ts-node -r tsconfig-paths/register src/admin/cli/bootstrap.ts",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/websockets": "11.2.3",
    "@thelastheart/contracts": "workspace:^",
    "ioredis": "5.6.1",
    "mpg123-decoder": "^1.0.3",
    "multer": "2.3.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "jest": "30.1.3",
    "prettier": "3.6.2",
    "socket.io-client": "4.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.43.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
