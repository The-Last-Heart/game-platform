# Safe local defaults for Docker Compose.
# Copy to .env (gitignored) only if you need overrides.
# Never use these values in production.

# Loopback-only publish by default. Override BIND_HOST only when you intentionally
# need LAN access (not recommended for unauthenticated Redis).
BIND_HOST=127.0.0.1

POSTGRES_PORT=5432
POSTGRES_USER=lh_local
POSTGRES_PASSWORD=lh_local_dev_only
POSTGRES_DB=the_last_heart

REDIS_PORT=6379

# API + Admin web (compose profile: apps)
BACKEND_PORT=3000
ADMIN_WEB_PORT=3001
BACKEND_LOG_LEVEL=log

# Browser-facing admin origin (loopback localhost / 127.0.0.1 are equivalent in BFF).
# When unset, Compose derives these from ADMIN_WEB_PORT.
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:3001
ADMIN_ALLOWED_ORIGIN=http://127.0.0.1:3001
# Keep in sync with apps/backend/.env.example for host ↔ Docker local use.
ADMIN_CSRF_SECRET=lh-dev-csrf-secret-change-me
COOKIE_SECURE=false
NEXT_PUBLIC_ADMIN_ENV=development

# Challenge Studio: allow the same admin to submit and approve (local only).
CONTENT_ALLOW_SELF_APPROVE=true

# Note: compose sets NODE_ENV=development for local app containers so HTTP
# cookies work on loopback. Do not treat this stack as a production deploy.
