# syntax=docker/dockerfile:1.7
# Local Docker image for @thelastheart/backend (NestJS).
# Build from repository root:
#   docker compose -f infra/local/docker-compose.yml build backend

ARG NODE_VERSION=24.21.0
ARG PNPM_VERSION=9.15.9

FROM node:${NODE_VERSION}-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/admin-web/package.json apps/admin-web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --strict-peer-dependencies

FROM deps AS build
COPY packages/contracts packages/contracts
COPY apps/backend apps/backend
RUN pnpm --filter @thelastheart/contracts build \
  && pnpm --filter @thelastheart/backend build \
  && pnpm --filter @thelastheart/backend deploy --prod /deploy/backend \
  && rm -rf /deploy/backend/dist \
  && cp -a /app/apps/backend/dist /deploy/backend/dist

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production \
  PORT=3000
WORKDIR /app
RUN useradd --create-home --uid 10001 lh
COPY --from=build --chown=lh:lh /deploy/backend/ ./
COPY --from=build --chown=lh:lh /app/apps/backend/content-pack ./content-pack
COPY --chmod=755 infra/local/docker-entrypoint-backend.sh /entrypoint.sh
USER lh
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=25s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "dist/main.js"]
