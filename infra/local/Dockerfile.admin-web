# syntax=docker/dockerfile:1.7
# Local Docker image for @thelastheart/admin-web (Next.js standalone).
# Build from repository root:
#   docker compose -f infra/local/docker-compose.yml build admin-web

ARG NODE_VERSION=24.21.0
ARG PNPM_VERSION=9.15.9

FROM node:${NODE_VERSION}-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/admin-web/package.json apps/admin-web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --strict-peer-dependencies

FROM deps AS build
COPY packages/contracts packages/contracts
COPY apps/admin-web apps/admin-web
# Next standalone needs contracts built for typecheck/transpile of workspace dep.
RUN pnpm --filter @thelastheart/contracts build \
  && pnpm --filter @thelastheart/admin-web build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production \
  PORT=3001 \
  HOSTNAME=0.0.0.0
WORKDIR /app
RUN useradd --create-home --uid 10001 lh

# Monorepo standalone output nests under apps/admin-web.
COPY --from=build --chown=lh:lh /app/apps/admin-web/.next/standalone ./
COPY --from=build --chown=lh:lh /app/apps/admin-web/.next/static ./apps/admin-web/.next/static
COPY --from=build --chown=lh:lh /app/apps/admin-web/public ./apps/admin-web/public

USER lh
WORKDIR /app/apps/admin-web
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --start-period=25s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/en/login').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
